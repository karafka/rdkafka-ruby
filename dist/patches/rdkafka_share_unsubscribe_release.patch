+/**
+ * @brief Wake up the unsubscribe call waiting for the share session
+ *        closes, if any.
+ *
+ * @locality main thread
+ */
+static void rd_kafka_share_unsubscribe_leave_done(rd_kafka_cgrp_t *rkcg) {
+        rkcg->rkcg_share.share_unsubscribe_leave_remaining_cnt = 0;
+
+        if (!rkcg->rkcg_share.share_unsubscribe_replyq)
+                return;
+
+        rd_kafka_q_enq(rkcg->rkcg_share.share_unsubscribe_replyq,
+                       rd_kafka_op_new(RD_KAFKA_OP_SHARE_COMMIT_ASYNC_FANOUT |
+                                       RD_KAFKA_OP_REPLY));
+        rd_kafka_q_destroy(rkcg->rkcg_share.share_unsubscribe_replyq);
+        rkcg->rkcg_share.share_unsubscribe_replyq = NULL;
+}
+
+/**
+ * @brief Account for one session close of an unsubscribe that replied or
+ *        will not be sent.
+ *
+ * @locality main thread
+ */
+static void rd_kafka_share_unsubscribe_leave_replied(rd_kafka_cgrp_t *rkcg) {
+        if (rkcg->rkcg_share.share_unsubscribe_leave_remaining_cnt > 0 &&
+            --rkcg->rkcg_share.share_unsubscribe_leave_remaining_cnt == 0)
+                rd_kafka_share_unsubscribe_leave_done(rkcg);
+}
+
+/**
+ * @brief Main thread handler closing the share sessions after an
+ *        unsubscribe.
+ *
+ * Mirrors the session close of the terminate path: pending
+ * acknowledgements are sent along with the close, and brokers with a
+ * request in flight close their session once it replies (Step 5b of
+ * rd_kafka_share_fetch_reply_op()).
+ *
+ * @locality main thread
+ */
+static rd_kafka_op_res_t
+rd_kafka_share_unsubscribe_close_sessions_op(rd_kafka_t *rk,
+                                             rd_kafka_q_t *rkq,
+                                             rd_kafka_op_t *rko) {
+        rd_kafka_cgrp_t *rkcg = rd_kafka_cgrp_get(rk);
+        rd_list_t *ack_batches =
+            rko->rko_u.share_commit_async_fanout.ack_batches;
+        rd_kafka_broker_t *rkb;
+
+        rko->rko_u.share_commit_async_fanout.ack_batches = NULL;
+
+        /* A previous unsubscribe call that gave up waiting */
+        rd_kafka_share_unsubscribe_leave_done(rkcg);
+
+        /* Take over the reply queue of the waiting unsubscribe call */
+        rkcg->rkcg_share.share_unsubscribe_replyq = rko->rko_replyq.q;
+        rko->rko_replyq.q                         = NULL;
+
+        /* Closing (which closes the sessions itself) or subscribed again:
+         * only flush the acknowledgements. */
+        if ((rkcg->rkcg_flags & RD_KAFKA_CGRP_F_TERMINATE) ||
+            rd_kafka_terminating(rk) ||
+            !rd_atomic32_get(&rk->rk_rkshare->rkshare_unsubscribed)) {
+                if (ack_batches)
+                        rd_kafka_share_segregate_and_dispatch_acks(
+                            rk, ack_batches, NULL);
+                rd_kafka_share_unsubscribe_leave_done(rkcg);
+                return RD_KAFKA_OP_RES_HANDLED;
+        }
+
+        if (ack_batches) {
+                rd_kafka_share_segregate_acks_by_leader(rk, ack_batches);
+                /* Ownership of elements transferred to broker ack_details.
+                 * Destroy the container. */
+                rd_list_destroy(ack_batches);
+        }
+
+        rd_kafka_rdlock(rk);
+        TAILQ_FOREACH(rkb, &rk->rk_brokers, rkb_link) {
+                if (rd_kafka_broker_or_instance_terminating(rkb) ||
+                    RD_KAFKA_BROKER_IS_LOGICAL(rkb))
+                        continue;
+
+                if (rkb->rkb_share_fetch_enqueued) {
+                        rd_kafka_dbg(rk, CGRP, "SHARE",
+                                     "Deferring share session close on "
+                                     "unsubscribe as broker %s has "
+                                     "in-flight request",
+                                     rd_kafka_broker_name(rkb));
+                        rkb->rkb_share_leave_pending = rd_true;
+                        rkcg->rkcg_share
+                            .share_unsubscribe_leave_remaining_cnt++;
+                        continue;
+                }
+
+                rd_kafka_share_enqueue_fetch_op(rk, rkb, rd_false, rd_true);
+                rkcg->rkcg_share.share_unsubscribe_leave_remaining_cnt++;
+        }
+        rd_kafka_rdunlock(rk);
+
+        if (rkcg->rkcg_share.share_unsubscribe_leave_remaining_cnt == 0)
+                rd_kafka_share_unsubscribe_leave_done(rkcg);
+
+        return RD_KAFKA_OP_RES_HANDLED;
+}
+
+/**
+ * @brief Close the share sessions after an unsubscribe.
+ *
+ * Acknowledgements made so far (all delivered records in implicit mode)
+ * are sent along with the session close; delivered records that were not
+ * acknowledged are released by it. The inflight map is cleared since none
+ * of its records can be acknowledged once the sessions are closed.
+ *
+ * Waits (bounded by socket.timeout.ms) until the sessions are closed,
+ * like rd_kafka_share_consumer_close() does, so a share fetch in flight
+ * completes before the call returns and records produced afterwards go
+ * to the other members.
+ *
+ * @locality app thread
+ */
+void rd_kafka_share_unsubscribe_close_sessions(rd_kafka_share_t *rkshare) {
+        rd_kafka_t *rk = rkshare->rkshare_rk;
+        rd_kafka_op_t *rko, *rko_reply;
+        rd_kafka_q_t *tmpq;
+
+        rd_kafka_share_acknowledge_all_if_implicit(rkshare);
+
+        rko = rd_kafka_op_new_cb(rk, RD_KAFKA_OP_SHARE_COMMIT_ASYNC_FANOUT,
+                                 rd_kafka_share_unsubscribe_close_sessions_op);
+        rko->rko_u.share_commit_async_fanout.ack_batches =
+            rd_kafka_share_build_ack_details(rkshare);
+
+        RD_MAP_CLEAR(&rkshare->rkshare_inflight_acks);
+        rkshare->rkshare_unacked_cnt = 0;
+
+        rd_kafka_share_drop_queued_responses(rkshare);
+
+        tmpq            = rd_kafka_q_new(rk);
+        rko->rko_replyq = RD_KAFKA_REPLYQ(tmpq, 0);
+        rd_kafka_q_enq(rk->rk_ops, rko);
+
+        rko_reply = rd_kafka_q_pop(
+            tmpq, rd_timeout_us(rk->rk_conf.socket_timeout_ms), 0);
+        if (rko_reply)
+                rd_kafka_op_destroy(rko_reply);
+        else
+                rd_kafka_dbg(rk, CGRP, "SHARE",
+                             "Timed out waiting for the share sessions to "
+                             "close on unsubscribe");
+
+        rd_kafka_q_destroy_owner(tmpq);
+
+        /* Responses of fetches that were in flight */
+        rd_kafka_share_drop_queued_responses(rkshare);
+}
