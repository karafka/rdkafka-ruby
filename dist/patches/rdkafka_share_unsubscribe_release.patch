 /**
+ * @brief Main thread handler for a SHARE_FETCH_RESPONSE that arrived
+ *        while the consumer was unsubscribed.
+ *
+ * Drops the response: the unsubscribe closes the share session, which
+ * releases its records. If the consumer subscribed again in the meantime
+ * (or is terminating), the response is handed to rkcg_q as usual.
+ *
+ * @locality main thread
+ */
+static rd_kafka_op_res_t
+rd_kafka_share_fetch_response_unsubscribed_op_cb(rd_kafka_t *rk,
+                                                 rd_kafka_q_t *rkq,
+                                                 rd_kafka_op_t *rko) {
+        rd_kafka_cgrp_t *rkcg = rd_kafka_cgrp_get(rk);
+
+        if (!rd_atomic32_get(&rk->rk_rkshare->rkshare_unsubscribed) ||
+            (rkcg->rkcg_flags & RD_KAFKA_CGRP_F_TERMINATE) ||
+            rd_kafka_terminating(rk)) {
+                rko->rko_type &= ~RD_KAFKA_OP_CB;
+                rko->rko_op_cb = NULL;
+                rd_kafka_q_enq(rkcg->rkcg_q, rko);
+                return RD_KAFKA_OP_RES_KEEP;
+        }
+
+        rd_kafka_dbg(rk, CGRP, "SHARE",
+                     "Dropping share fetch response received while "
+                     "unsubscribed");
+
+        /* The op destructor frees the message ops. */
+        return RD_KAFKA_OP_RES_HANDLED;
+}
+
+/**
+ * @brief Enqueue a share fetch response for the application or, while
+ *        the consumer is unsubscribed, hand it to the main thread to be
+ *        dropped.
+ *
+ * @locality broker thread
+ */
+void rd_kafka_share_fetch_response_enq(rd_kafka_t *rk,
+                                       rd_kafka_op_t *response_rko) {
+        if (rk->rk_rkshare &&
+            rd_atomic32_get(&rk->rk_rkshare->rkshare_unsubscribed) &&
+            !rd_kafka_terminating(rk)) {
+                response_rko->rko_type |= RD_KAFKA_OP_CB;
+                response_rko->rko_op_cb =
+                    rd_kafka_share_fetch_response_unsubscribed_op_cb;
+                rd_kafka_q_enq(rk->rk_ops, response_rko);
+                return;
+        }
+
+        rd_kafka_q_enq(rk->rk_cgrp->rkcg_q, response_rko);
+}
+
+/**
+ * @brief Drop share fetch responses left on rkcg_q after an unsubscribe.
+ *
+ * The app does not consume rkcg_q while unsubscribed and the closed share
+ * sessions released their records, so the responses would otherwise only
+ * hand stale records to the app after a new subscription. Other ops stay
+ * queued.
+ *
+ * @locality app thread
+ */
+void rd_kafka_share_drop_queued_responses(rd_kafka_share_t *rkshare) {
+        rd_kafka_t *rk        = rkshare->rkshare_rk;
+        rd_kafka_cgrp_t *rkcg = rd_kafka_cgrp_get(rk);
+        rd_kafka_q_t *rkq, *fwdq;
+        rd_kafka_op_t *rko, *next;
+        TAILQ_HEAD(, rd_kafka_op_s) responses;
+
+        if (!rkcg || !rd_atomic32_get(&rkshare->rkshare_unsubscribed))
+                return;
+
+        TAILQ_INIT(&responses);
+
+        rkq = rkcg->rkcg_q;
+        if ((fwdq = rd_kafka_q_fwd_get(rkq, 1 /*lock*/)))
+                rkq = fwdq;
+
+        mtx_lock(&rkq->rkq_lock);
+        next = TAILQ_FIRST(&rkq->rkq_q);
+        while ((rko = next)) {
+                next = TAILQ_NEXT(rko, rko_link);
+                if (rko->rko_type != RD_KAFKA_OP_SHARE_FETCH_RESPONSE)
+                        continue;
+                rd_kafka_q_deq0(rkq, rko);
+                TAILQ_INSERT_TAIL(&responses, rko, rko_link);
+        }
+        mtx_unlock(&rkq->rkq_lock);
+
+        if (fwdq)
+                rd_kafka_q_destroy(fwdq);
+
+        while ((rko = TAILQ_FIRST(&responses))) {
+                TAILQ_REMOVE(&responses, rko, rko_link);
+                rd_kafka_op_destroy(rko);
+        }
+}
